{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/cancel-stale-orders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/notify-restock",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/abandoned-checkout-alerts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "30 5 * * *"
    }
  ]
}
